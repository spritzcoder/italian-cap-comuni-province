{
  "name": "italian-cap-comuni-province",
  "version": "1.1.1",
  "description": "🇮🇹 Complete TypeScript library for Italian locations: municipalities, provinces, postal codes with advanced search and autocomplete",
  "keywords": [
    "italy",
    "italian",
    "locations",
    "municipalities",
    "comuni",
    "provinces",
    "postal-codes",
    "cap",
    "geocoding",
    "search",
    "autocomplete",
    "typescript"
  ],
  "author": "SpritzCoder <spritzcoder@users.noreply.github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spritzcoder/italian-cap-comuni-province.git"
  },
  "bugs": {
    "url": "https://github.com/spritzcoder/italian-cap-comuni-province/issues"
  },
  "homepage": "https://github.com/spritzcoder/italian-cap-comuni-province#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch src --watch scripts/data",
    "dev": "tsup --watch src --watch scripts/data",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "audit": "npm audit --include=dev",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "data:build": "node scripts/data/build.mjs",
    "data:verify": "node scripts/data/cli.mjs verify",
    "data:check": "node scripts/data/cli.mjs check",
    "data:update": "node scripts/data/cli.mjs update",
    "pretest": "npm run data:build",
    "pretype-check": "npm run data:build",
    "prepack": "npm run build",
    "benchmark": "node scripts/benchmark.mjs",
    "test:package": "node scripts/test-package.mjs",
    "pretest:coverage": "npm run data:build",
    "test:build": "node scripts/test-build.mjs",
    "pretest:watch": "npm run data:build",
    "pretest:ui": "npm run data:build"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.37.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
